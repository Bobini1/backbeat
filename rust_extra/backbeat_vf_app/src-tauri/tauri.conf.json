{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Backbeat Virtual Folders",
	"version": "0.1.0",
	"identifier": "ac.backbeat.vf",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1421",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [{ "label": "main", "title": "Backbeat Virtual Folders", "width": 980, "height": 720, "backgroundColor": "#17191c" }],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/icon.png"
		]
	}
}
